# Copy this to .env.local for local work. .env.local is gitignored — never
# commit real values.

# "false" -> the real site is served
# anything else, including unset -> the holding page at /coming-soon
#
# It fails closed on purpose: a missing variable should never expose an
# unfinished site.
COMING_SOON=false

# Lets you (or a client) see the real site while COMING_SOON=true.
# Visit  https://quietloopdigital.com/?preview=<this value>  once; a cookie
# is set and you browse normally for 30 days. Pick something unguessable.
PREVIEW_TOKEN=change-me
